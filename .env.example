# Copy to .env for local runs. In GitHub Actions these come from repo Secrets instead.

GEMINI_API_KEY=your_gemini_api_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# YouTube OAuth — generate a refresh token once locally (see README "YouTube auth setup"),
# then store these three as GitHub Secrets. The pipeline never does an interactive login.
YOUTUBE_CLIENT_ID=your_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
